# UrbanShield Configuration Example
# Copy this file to .env and update with your values

# ============================================================
# API Configuration
# ============================================================
# API server bind address
API_HOST=0.0.0.0

# API server port
API_PORT=8000

# Enable hot-reload during development (disable in production)
API_RELOAD=true

# Frontend URL for API access (what the browser will use)
FRONTEND_API_BASE=http://localhost:8000

# ============================================================
# AI Assistant Configuration
# ============================================================
# Free local provider (requires Ollama: https://ollama.com/download/windows)
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# Optional OpenAI provider
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here

# Optional Anthropic provider
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# Database Configuration (PostGIS - future)
# ============================================================
# PostgreSQL user for production database
DB_USER=urbanshield

# PostgreSQL password
DB_PASSWORD=urbanshield_dev

# PostgreSQL host
DB_HOST=localhost

# PostgreSQL port
DB_PORT=5432

# Database name
DB_NAME=urbanshield_db

# ============================================================
# Data & File Paths
# ============================================================
# Path to scored assets CSV (relative or absolute)
DATA_PATH=./db/assets_scored.csv

# Path to river geometry JSON (relative or absolute)
RIVER_LAYER_PATH=./db/river.json

# ============================================================
# Logging Configuration
# ============================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path (relative or absolute)
LOG_FILE=./logs/urbanshield.log
